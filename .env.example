# Copy this file to .env. Never commit .env.

# Required for Lakebase-backed local development. Choose a profile explicitly;
# the project never assumes a profile.
DATABRICKS_CONFIG_PROFILE=
# Example: projects/my-project/branches/my-branch/endpoints/primary
LAKEBASE_ENDPOINT=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGSSLMODE=require
LAKEBASE_APP_SCHEMA=route_scenario_modeling

# The default path uses local OR-Tools with an approximate travel matrix.
ROUTE_EXECUTION_MODE=approximate_development
VALHALLA_ALLOW_HAVERSINE_FALLBACK=false

# Required by bundle deployment because the database owner is workspace-specific.
DATABRICKS_BUNDLE_VAR_catalog=
DATABRICKS_BUNDLE_VAR_lakebase_database_owner_role_id=

# Optional advanced routing services. Set only when selecting the matching mode.
# DATABRICKS_ROUTE_SOLVER_ENDPOINT=<serving-endpoint-name>
# ROUTING_COVERAGE_MANIFEST=<path-to-validated-coverage-manifest>
# VALHALLA_APP_URL=<https-url-or-databricks-app-name>
# VALHALLA_COSTING=truck
# VALHALLA_MAX_SNAP_DISTANCE_MILES=0.25
