{
  "name": "enhanced-example",
  "preset": "enhanced",
  "variables": {
    "catalog": "my_catalog",
    "lakebase_database_owner_role_id": "dbrx-apps-REPLACE_ME",
    "route_solver_endpoint_name": "route-solver-dev"
  },
  "routing": {
    "mode": "serving_regional",
    "solver_endpoint": "route-solver-dev",
    "valhalla": {
      "strategy": "reuse",
      "app": "valhalla-service",
      "region": "texas",
      "volume": "my_catalog.route_scenario_modeling.valhalla_assets",
      "coverage_manifest": "routing_coverage/texas-service.v1.json",
      "coverage_id": "texas-delivery",
      "smoke_points": [
        "32.7767,-96.7970",
        "29.7604,-95.3698"
      ],
      "validate_on_deploy": false
    },
    "costing": "truck",
    "max_snap_distance_miles": 0.25,
    "allow_haversine_fallback": true
  }
}
